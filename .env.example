# Discord Bot
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_client_id
GUILD_ID=your_discord_guild_id

# Multi-tenant ownership (who can sell/provision buyer servers)
# Defaults: OWNER_GUILD_ID falls back to GUILD_ID; OWNER_ROLE_ID is the owners role.
OWNER_GUILD_ID=1205897412502224947
OWNER_ROLE_ID=1495828353649999984
# Comma-separated Discord user IDs with full owner access everywhere
SUPER_OWNER_IDS=763912131153887264

# Discord IDs (roles + channels)
STAFF_ROLE_ID=
DONATOR_ROLE_ID=
BRONZE_ROLE_ID=
SILVER_ROLE_ID=
GOLD_ROLE_ID=
ACTIVATORS_ROLE_ID=
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=
STOCK_NOTIF_CHANNEL_ID=
VOUCHER_CHANNEL_ID=

# Branding
BOT_NAME=OpenSteam
PATREON_URL=https://www.patreon.com/14456576/join

# Cooldowns (hours)
COOLDOWN_GOLD=8
COOLDOWN_SILVER=16
COOLDOWN_BRONZE=20
DUTY_RESET_HOURS=8

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/opensteam

# Cloud hosting (Render sets RENDER_EXTERNAL_URL automatically; Railway sets RAILWAY_PUBLIC_DOMAIN)
# PUBLIC_URL=https://your-service.onrender.com

# Steampass.gg (headless token generation — disabled by default; use SteamAuth instead)
# When true, steampass API is not called — but saved SteamSession refresh_tokens are still reused.
STEAMPASS_DISABLED=true
STEAMPASS_LOGIN=
STEAMPASS_PASSWORD=

# OpenSteam Auth Service (https://steamauth.gamegen.lol/docs) — safer Steam Guard source
# Create an API key in the dashboard (admin). Link accounts via /steamauth link or /steamauth sync
# Bot uses GET /health, GET /api/v1/accounts, GET /api/v1/accounts/:uuid/guard-code or /credentials
STEAMAUTH_API_URL=https://steamauth.gamegen.lol
STEAMAUTH_API_KEY=

# EA / Origin Denuvo (ea-service + setup zips)
# EA_SERVICE_URL=https://your-ea-service.up.railway.app
# EA_SERVICE_KEY=shared-secret-with-ea-service
# EA_MAGIC_DIR=   optional override; default is repo ea-magic/ (mount a volume on Railway)

# Groq AI (screenshot verification)
GROQ_API_KEY=

# Patreon -> Discord role sync (bronze/silver/gold, home server only)
# 1. Create a client at https://www.patreon.com/portal/registration/register-clients
#    (scopes: identity, campaigns, campaigns.members, w:campaigns.webhook)
# 2. Copy the "Creator's Access Token" shown on that client's page.
# 3. GET https://www.patreon.com/api/oauth2/v2/campaigns with that token to get your campaign id.
# 4. GET https://www.patreon.com/api/oauth2/v2/campaigns/<id>?include=tiers&fields[tier]=title,amount_cents
#    to get your tier ids, map the three you want to bronze/silver/gold below.
# 5. On the client's page, add a webhook pointed at <PUBLIC_URL>/webhooks/patreon with triggers
#    members:pledge:create, members:pledge:update, members:pledge:delete — copy its secret.
# 6. For user-facing OAuth linking, configure one of the Redirect URIs in your Patreon app client 
#    pointing to <YOUR_PUBLIC_URL>/patreon/oauth/callback (e.g. https://denuvo-bot.up.railway.app/patreon/oauth/callback).
#    Copy the Client ID and Client Secret from that client page.
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
PATREON_WEBHOOK_SECRET=
PATREON_TIER_BRONZE_ID=
PATREON_TIER_SILVER_ID=
PATREON_TIER_GOLD_ID=
PATREON_SYNC_INTERVAL_MINUTES=30

# Patreon OAuth (Optional, for linking via bot /patreon-account-link)
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=

