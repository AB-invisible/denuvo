generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  appId           Int?
  stock           Int      @default(5)
  lastDepletedAt  DateTime?
  disabled        Boolean  @default(false)
  highDemand      Boolean  @default(false)
  donatorOnly     Boolean  @default(false)
  boosterOnly     Boolean  @default(false)
  excludeRegen    Boolean  @default(false)
  autoGenDisabled Boolean  @default(false)
  steampassUuid   String?
  generationMode  String   @default("gbe")
  manuallyAdded   Boolean  @default(false)
  // ─── Ubisoft / Uplay Denuvo games ───────────────────────────────
  // A game is treated as a UBISOFT game (two-step magic-files + token_req
  // flow via ubisoft-service) when ubisoftAppId is set. ubisoftAltAppId is
  // the tool's known fallback appid (it tries the primary first, then this).
  // ubisoftMagicFile names the crack/"magic files" zip served to the user
  // (resolved by payloadServer /ubisoft/magic/<appId> from UBISOFT_MAGIC_DIR).
  ubisoftAppId    Int?
  ubisoftAltAppId Int?
  ubisoftMagicFile String?
  // ─── EA / Origin Denuvo games ───────────────────────────────────
  // Two-step flow via ea-service when eaContentId + eaEngine are set.
  eaContentId     Int?
  eaEngine        String?
  eaMagicFile     String?
  updatedAt       DateTime @default(now()) @updatedAt
  tickets         Ticket[]
  restocks        Restock[]
  subscriptions   Subscription[]
  waitlist        Waitlist[]
  serverStocks    ServerStock[]
  reservations    PatreonReservation[]
}

model Ticket {
  id        Int      @id @default(autoincrement())
  channelId        String   @unique
  controlMessageId String?
  guildId          String?
  userId           String
  gameId           Int
  game      Game     @relation(fields: [gameId], references: [id])
  status             String   @default("OPEN") // OPEN, CLAIMED, CLOSED
  staffId            String?
  screenshotVerified Boolean  @default(false)
  vouchExpiresAt        DateTime?
  vouchStaffId          String?
  vouchChannelMessageId String?
  deliveryMessageId     String?
  activeClosingStaffId  String?
  claimedAt             DateTime?
  closedAt              DateTime?
  lastUserActivityAt    DateTime @default(now())
  fromQueue             Boolean  @default(false)
  /// True once this ticket has taken its token off the panel. Every delivery
  /// path routes through consumeStockForTicket(), so one ticket can only ever
  /// cost one token no matter how it closes.
  stockConsumed         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt
  verification          PendingVerification?
  // ─── Ubisoft two-step flow state ────────────────────────────────
  // null       → not a Ubisoft ticket (or not started)
  // AWAITING_TOKEN_REQ → magic files delivered; bot is waiting for the
  //              user to paste/upload the NEW token_req from the game
  // DONE       → token.ini delivered
  // Mirrors how screenshotVerified gates the Steam flow, but the Ubisoft
  // flow has an extra round-trip (user must run the game first).
  ubisoftStage          String?
  // ─── EA two-step flow state ─────────────────────────────────────
  // null → not EA / not started
  // AWAITING_TICKET → setup files delivered; waiting for Denuvo ticket
  // DONE → token.ini delivered
  eaStage               String?

  @@index([status])
  @@index([guildId, status])
  @@index([userId, status])
  @@index([vouchExpiresAt])
}

model PendingVerification {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @unique
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  retryCount  Int      @default(0)
  isProcessing Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt
}

model Maintenance {
  id        Int      @id @default(autoincrement())
  channelId String   @unique
  messageId String
  endTime   DateTime
  createdAt DateTime @default(now())
}

model Cooldown {
  id        Int      @id @default(autoincrement())
  userId    String
  guildId   String   @default("")
  until     DateTime
  createdAt DateTime @default(now())
  @@unique([userId, guildId])
  @@index([until])
}

// Staff-managed permanent ban from opening Denuvo activation tickets.
model DenuvoBlacklist {
  id        Int      @id @default(autoincrement())
  userId    String
  guildId   String   @default("")
  reason    String?
  staffId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([guildId])
}

model Panel {
  id        Int      @id @default(autoincrement())
  channelId String
  messageId String
  createdAt DateTime @default(now())

  @@index([channelId])
}

// Bug #20: Verification model removed — unused (state is managed in-memory via pendingVerifications map)

model Restock {
  id        Int      @id @default(autoincrement())
  gameId    Int
  guildId   String   @default("")
  game      Game     @relation(fields: [gameId], references: [id])
  restockAt DateTime
  createdAt DateTime @default(now())

  @@index([guildId, restockAt])
}

model Metadata {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model ServerStock {
  id             Int       @id @default(autoincrement())
  gameId         Int
  guildId        String
  stock          Int       @default(5)
  /// What a refill resets `stock` back to. Set by /settokens.
  maxStock       Int       @default(5)
  /// When the FIRST token of the current 24h cycle was used. The game refills
  /// to maxStock at cycleStartedAt + 24h; later uses in the same cycle do NOT
  /// push that out. Null = no cycle running. Each game clocks independently.
  cycleStartedAt DateTime?
  lastDepletedAt DateTime?
  game           Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, guildId])
  @@index([cycleStartedAt])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    String
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

model DutyStatus {
  id          Int      @id @default(autoincrement())
  staffId     String   @unique
  isOnDuty    Boolean  @default(false)
  lastUpdated DateTime @default(now())
}

// Self-hosted, time-limited token download. Bot writes the file to a
// known directory + creates one row per delivery. Installer fetches the
// zip via GET /download/<token>. Expired or deleted rows return 404.
//
// Anti-sharing: each row also carries an `installerKey` separate from
// the download token. The installer.exe POSTs this key to
// /installer-validate/<key> on first run; the bot flips `consumed=true`
// and refuses subsequent calls. If a user shares the zip, the second
// installer run gets 410 → nuclear self-destruct.
// Cached Steam account session per steampass UUID. Lets the token
// generator skip steampass.gg for repeat gens of the same account:
//
//   1. Try refresh_token login (0 steampass calls — Steam CM accepts
//      the saved token directly, ~30-day TTL).
//   2. Fall back to cached login+password from a prior steampass fetch
//      (1 steampass call — only /email/code/main for the guard code,
//      we skip /profile/product-credentials).
//   3. Fall back to full steampass flow (2 calls — /profile + /email/code).
//
// Anything that succeeds writes the resulting refresh_token + creds back
// here so the next gen has a fresher cache to work with.
//
// Credentials are stored in plaintext for now — same trust boundary as
// steampass itself (which serves them in plaintext on every call). If
// we add at-rest encryption later it'd go here, with a key wrapped by
// the HMAC_SECRET env var.
model SteamSession {
  id              Int       @id @default(autoincrement())
  // Which tenant server this cached session belongs to. The steampass
  // UUID is GLOBAL (the same product UUID works on every steampass
  // account), but each buyer server logs in with its OWN steampass
  // account — so the resulting Steam session (login/password/refresh
  // token) is account-specific and must NOT leak across servers. Keying
  // by (guildId, steampassUuid) keeps Server A's cached session from
  // being reused for Server B even though they share the UUID.
  //
  // "" (empty string) = the owner/home server, which uses the global
  // STEAMPASS_LOGIN/PASSWORD env account. Defaulting to "" keeps every
  // pre-multitenant row valid (they were all the home account).
  guildId         String    @default("")
  // WHICH steampass account fetched this session. Critical for the owner
  // account POOL: every pool account shares guildId="" but backs a
  // DIFFERENT Steam account, so (guildId, steampassUuid) alone would let
  // pool account A's cached refresh_token be reused for account B (wrong
  // creds — "cache poisoning"). Including the steampass login in the key
  // gives each pool account its own cached session per game, so the cache
  // can be safely reused for pool gens instead of being disabled.
  // Defaults to "" so pre-existing rows stay valid (they get re-seeded
  // with the real login on their next successful gen).
  steampassLogin  String    @default("")
  steampassUuid   String
  // Cached Steam credentials from a prior /profile/product-credentials fetch.
  steamLogin      String
  steamPassword   String
  guarded         Boolean   @default(true)
  // Long-lived Steam refresh token (~30 day TTL). Null if we've never
  // managed to do a Steam CM login successfully, or if the last login
  // attempt didn't return a refresh token (older protocol path).
  refreshToken    String?
  steamId         String?
  // Health + telemetry — useful for staff log lines and the periodic
  // cleanup sweep that drops sessions inactive for >25 days (proactive
  // re-auth before the ~30-day refresh-token TTL bites us mid-gen).
  lastLoginAt     DateTime?
  lastLoginSource String?   // "refresh_token" | "cached_creds" | "steampass"
  failureCount    Int       @default(0)
  lastFailureAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([guildId, steampassLogin, steampassUuid])
}

// A buyer server that has been sold/authorized to use the bot. The
// owner (OWNER_ROLE_ID in OWNER_GUILD_ID) provisions these via
// /addserver. Every field except the steampass account is optional and
// falls back to the global env CONFIG.* when null — so a server can be
// activated with just credentials and configured further later.
//
// SECURITY: steampassLogin/Password are the buyer server's steampass.gg
// account. They are visible ONLY to the owner (via /listservers in the
// home server) and are never logged to a tenant's own log channel.
// Stored in plaintext for now — same trust boundary as SteamSession
// (which already holds Steam creds in plaintext).
model TenantServer {
  id                  Int      @id @default(autoincrement())
  guildId             String   @unique
  serverName          String
  inviteLink          String?
  // Per-server steampass account (email + password). Swapped in for the
  // global STEAMPASS_LOGIN/PASSWORD env when this server generates a token.
  steampassLogin      String
  steampassPassword   String
  // Per-server Discord wiring. Null → fall back to global CONFIG.* env.
  logChannelId        String?  // BASIC log channel (sanitized events only)
  staffRoleId         String?
  activatorsRoleId    String?
  ticketCategoryId    String?
  voucherChannelId    String?
  stockNotifChannelId String?
  donatorRoleId       String?
  bronzeRoleId        String?
  silverRoleId        String?
  goldRoleId          String?
  botName             String?
  patreonUrl          String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

// ─── OWNER-ONLY steampass account pool ───────────────────────────
// The owner/home server can hold MULTIPLE steampass accounts and rotate
// between them. Each account can produce a limited number of tokens PER
// GAME PER 24h (Denuvo activation limit — default 5). When an account's
// daily quota for a given game is exhausted, the bot rotates to the next
// active account for that game until the UTC day rolls over.
//
// Buyer (tenant) servers do NOT use this pool — they each have a single
// steampass account on their TenantServer row and no rotation.
model SteampassAccount {
  id        Int      @id @default(autoincrement())
  label     String?               // human label, e.g. "acct-1"
  login     String   @unique      // steampass email
  password  String                // steampass password
  // Cached steampass bearer for THIS account. Auto-captured after a real
  // POST /auth/login and reused on later gens so the bot skips /auth/login
  // (the endpoint steampass rate-limits / IP-bans). Cleared + re-captured
  // automatically when steampass rejects it with 401/403. Can also be set
  // manually via /setsteampass account:<id>. "" = none cached yet.
  token     String   @default("")
  active    Boolean  @default(true)
  priority  Int      @default(100) // lower = tried first
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  usages    SteampassUsage[]
  games     SteampassAccountGame[]
}

// Which catalog games a pool account can generate for. Stock + rotation only
// count accounts linked here — not every pool account owns every game.
model SteampassAccountGame {
  id        Int              @id @default(autoincrement())
  accountId Int
  account   SteampassAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appId     Int
  createdAt DateTime         @default(now())

  @@unique([accountId, appId])
  @@index([appId])
}

// Per-account, per-game, per-day token counter for the owner pool.
// usageDate is a "YYYY-MM-DD" UTC string so a daily reset is just a new
// key. count is capped in code at OWNER_TOKENS_PER_ACCOUNT_PER_DAY.
model SteampassUsage {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   SteampassAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appId     Int
  usageDate String   // "YYYY-MM-DD" UTC
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, appId, usageDate])
}

// ─── Owner-provided (BYO) Steam accounts ─────────────────────────
// A real Steam account the owner OWNS that already has a specific game.
// The bot logs into it DIRECTLY (no steampass) and generates tokens for
// its game, up to the Denuvo per-account daily cap (default 5). When the
// day's quota is spent, gen falls back to the steampass pool. Added via
// /addsteamaccount. Credentials are stored plaintext — same trust boundary
// as SteampassAccount / SteamSession.
model OwnedSteamAccount {
  id            Int      @id @default(autoincrement())
  // Owning server. "" = owner/home. Keeps one server's accounts from being
  // used by another (accounts are visible only where they were added).
  guildId       String   @default("")
  // The Steam AppID this account owns and can generate for.
  appId         Int
  label         String?
  steamLogin    String
  steamPassword String
  // TOTP mobile-authenticator secret. Null = the account has Steam Guard
  // OFF (login with just username+password). When set, the bot generates
  // the Guard code itself each login.
  sharedSecret  String?
  // Cached long-lived refresh_token (~200-day) so repeat gens skip even the
  // password login. Captured after the first successful login.
  refreshToken  String?
  steamId       String?
  active        Boolean  @default(true)
  priority      Int      @default(100) // lower = tried first
  failureCount  Int      @default(0)
  lastFailureAt DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  usages        OwnedSteamUsage[]

  @@unique([guildId, appId, steamLogin])
}

// Per-account, per-day token counter for owned accounts. usageDate is a
// "YYYY-MM-DD" UTC string; count is capped in code at the Denuvo daily
// limit (OWNER_TOKENS_PER_ACCOUNT_PER_DAY). One game per account, so this
// is effectively per-account/day.
model OwnedSteamUsage {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   OwnedSteamAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usageDate String   // "YYYY-MM-DD" UTC
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, usageDate])
}

// ─── OpenSteam Auth Service (steamauth.gamegen.lol) accounts ─────────
// Links a service account UUID to an AppID. At gen time the bot calls
// GET /api/v1/accounts/:id/credentials (API key only) — no password stored.
// Used first for autogen, then BYO owned accounts, then steampass pool.
model SteamAuthAccount {
  id            Int      @id @default(autoincrement())
  guildId       String   @default("")
  appId         Int
  // UUID from steamauth (public_id / account_id).
  accountId     String
  label         String?
  steamLogin    String
  // Legacy field — no longer populated for new links (credentials come from API).
  steamPassword String   @default("")
  refreshToken  String?
  steamId       String?
  active        Boolean  @default(true)
  priority      Int      @default(100)
  failureCount  Int      @default(0)
  lastFailureAt DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  usages        SteamAuthUsage[]

  @@unique([guildId, appId, accountId])
  @@index([appId, active])
}

model SteamAuthUsage {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   SteamAuthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usageDate String
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, usageDate])
}

model TokenDownload {
  token         String   @id            // random opaque ID used in the download URL
  installerKey  String?  @unique        // separate per-zip secret embedded in payload-manifest.json
  // HMAC-binding: ties the installer key to THIS specific zip's ticket so
  // an attacker can't swap _sig in someone else's zip with an unused key
  // from their own. expectedHmac = hmac_sha256(HMAC_SECRET, sig|appId|ticketHash).
  // Server recomputes on validate and rejects on mismatch.
  ticketHash    String?                  // sha256(token_b64) — bound to this zip's actual ticket
  expectedHmac  String?                  // hmac_sha256(HMAC_SECRET, sig|appId|ticketHash)
  appId         Int?                     // bound app id for validation cross-check
  filePath      String                  // server-side absolute path
  fileName      String                  // suggested filename for Content-Disposition
  fileSize      Int                     // bytes (informational + Content-Length)
  expiresAt     DateTime                // hard cap — 30 min from createdAt
  createdAt     DateTime @default(now())
  claimedAt     DateTime?               // first time the file was streamed (for stats only)
  consumed      Boolean  @default(false) // true once /installer-validate has succeeded once
  consumedAt    DateTime?               // when the installer actually ran for this zip
  ticketId      Int?                    // optional link back to the ticket that produced this
  // True for tokens generated by /tokengen OUTSIDE a ticket channel
  // (staff testing, sharing, ad-hoc gen in a normal channel). When set:
  //   - the download link's expiresAt is set ~100 years in the future
  //     so /download and cleanupExpiredDownloads treat it as alive forever
  //   - /installer-validate doesn't flip `consumed` on success, so the
  //     installer can be re-run as many times as needed
  // Inside a ticket the field stays false and single-use enforcement
  // works as normal.
  persistent    Boolean  @default(false)

  // ── Self-driving installer (EA / Ubisoft call-home flow) ──
  // When a row backs a "denuvo-callhome" installer, these carry the context
  // the /activate/<installerKey> endpoint needs to mint the token itself
  // (instead of the user pasting token_req into the ticket). platform is
  // "ea" | "ubisoft"; null for normal Steam token rows.
  platform       String?
  eaContentId    Int?
  eaEngine       String?
  ubisoftAppId   Int?
  ubisoftAltAppId Int?
  guildId        String?
}

model GameRequest {
  id        Int      @id @default(autoincrement())
  userId    String
  gameName  String
  createdAt DateTime @default(now())

  @@unique([userId, gameName])
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  effect      String    // 'cooldown_reset' | 'temp_tier'
  tierGrant   String?   // 'Gold' | 'Silver' | 'Bronze'
  durationH   Int?      // hours the tier effect lasts
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id         Int       @id @default(autoincrement())
  userId     String
  promoId    Int
  guildId    String    @default("")
  promo      PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  redeemedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@unique([userId, promoId, guildId])
}

model Waitlist {
  id         Int       @id @default(autoincrement())
  userId     String
  gameId     Int
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
}

// ─── Ubisoft accounts (BYO) for token minting ───────────────────────
// A real Ubisoft account the owner OWNS the games on. The bot passes its
// credentials to ubisoft-service (POST /ubisoft/token), up to the Denuvo
// per-account daily cap (OWNER_TOKENS_PER_ACCOUNT_PER_DAY, default 5).
// When the day's quota is spent, gen rotates to the next active account,
// then falls back to the service's default UBISOFT_EMAIL/PASSWORD env.
// Added via /ubisoftaccount. Credentials are stored plaintext — same trust
// boundary as SteampassAccount / OwnedSteamAccount.
//
// NOTE: unlike Steam, Ubisoft accounts are NOT tied to a single appId —
// one account can own many Ubisoft games — so there's no appId column and
// the daily counter is per-account/day (not per-account/appId/day).
model UbisoftAccount {
  id            Int      @id @default(autoincrement())
  guildId       String   @default("")
  label         String?
  email         String
  password      String
  active        Boolean  @default(true)
  priority      Int      @default(100) // lower = tried first
  failureCount  Int      @default(0)
  lastFailureAt DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  usages        UbisoftUsage[]

  @@unique([guildId, email])
}

// Per-account, per-title, per-day token counter for Ubisoft accounts.
// usageDate is a "YYYY-MM-DD" UTC string; count is capped in code at the
// Denuvo daily limit (OWNER_TOKENS_PER_ACCOUNT_PER_DAY) **per Ubisoft title**.
model UbisoftUsage {
  id           Int      @id @default(autoincrement())
  accountId    Int
  account      UbisoftAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ubisoftAppId Int      @default(0)
  usageDate    String   // "YYYY-MM-DD" UTC
  count        Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([accountId, ubisoftAppId, usageDate])
  @@index([ubisoftAppId, usageDate])
}

// ─── EA accounts (BYO) for token minting ────────────────────────────
model EaAccount {
  id            Int      @id @default(autoincrement())
  guildId       String   @default("")
  label         String?
  email         String
  password      String
  active        Boolean  @default(true)
  priority      Int      @default(100)
  failureCount  Int      @default(0)
  lastFailureAt DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  usages        EaUsage[]

  @@unique([guildId, email])
}

model EaUsage {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   EaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usageDate String
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, usageDate])
}

// ─── Patreon → Discord role sync (bronze/silver/gold + donator) ────
// One row per Patreon campaign member we've ever seen, keyed by Patreon's
// own member UUID (stable across pledge changes, unlike tier/status).
// discordId is resolved from the patron's Patreon "Connected Accounts"
// (social_connections.discord.user_id) — null means the patron hasn't
// linked Discord on patreon.com yet, so we can't role them and staff can
// see them via `/patreon list` to nudge them to link it.
//
// This table is a cache/audit trail, NOT the source of truth — every sync
// (webhook or periodic) re-fetches the live Patreon member + re-reads the
// live Discord member's roles before deciding what to add/remove. That
// means a row going stale (bot offline, role changed manually, etc.) can
// never cause an incorrect grant — worst case is it just gets corrected on
// the next sync.
model PatreonMember {
  id              Int      @id @default(autoincrement())
  patreonMemberId String   @unique
  patreonUserId   String?  @unique
  discordId       String?
  patronStatus    String?  // active_patron | declined_patron | former_patron | null
  tier            String?  // "bronze" | "silver" | "gold" | null (none/unmapped)
  tierAmountCents Int?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([discordId])
  @@index([tier])
}

// ─── Patreon monthly bypass reservation ──────────────────────────────
// One row per active reservation. Created when a patron uses /claim on
// an out-of-stock high-demand game. The bot restocks 5 tokens, reserves
// the 5th for this user until UTC midnight. If unused by 00:00 UTC, a
// scheduler voids it (sets status=VOIDED) and does NOT refund the
// monthly claim.
model PatreonReservation {
  id          Int       @id @default(autoincrement())
  userId      String
  guildId     String
  gameId      Int
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// "YYYY-MM" UTC — the month this claim was charged to
  claimMonth  String
  status      String    @default("ACTIVE")  // ACTIVE | FULFILLED | VOIDED
  expiresAt   DateTime                      // UTC midnight of the claim day
  fulfilledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([userId, guildId, gameId, claimMonth])
  @@index([status, expiresAt])
  @@index([gameId, status])
}
