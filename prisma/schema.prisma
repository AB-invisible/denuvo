generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  appId           Int?
  stock           Int      @default(5)
  lastDepletedAt  DateTime?
  disabled        Boolean  @default(false)
  highDemand      Boolean  @default(false)
  donatorOnly     Boolean  @default(false)
  boosterOnly     Boolean  @default(false)
  excludeRegen    Boolean  @default(false)
  // Per-game pause for auto token generation after AI screenshot verify.
  // When true, the bot still verifies the user's screenshot but routes the
  // ticket to staff for manual delivery instead of running headless_token.py.
  // Independent of the global `autoGenEnabled` metadata flag — either one
  // being "off" is enough to bypass auto-gen for a ticket on this game.
  autoGenDisabled Boolean  @default(false)
  steampassUuid   String?  // steampass.gg product UUID for headless token generation
  // Generation mode for token zips. Valid values:
  //   "gbe"               -> flat GBE Normal (steam_api64.dll + steamclient64.dll + steam_settings)
  //   "coldloader"        -> V2 DLL hijack (coldloader.dll + version/dinput8/winmm proxy)
  //   "coldclientloader"  -> V1 launcher (START_<game>.exe + ColdClientLoader.ini)
  generationMode  String   @default("gbe")
  // True for games created via /game add slash command (not from denuvo.json).
  // syncManager.ts skips the auto-disable pass for these so the next JSON
  // sync doesn't hide manually-added games.
  manuallyAdded   Boolean  @default(false)
  updatedAt       DateTime @default(now()) @updatedAt
  tickets         Ticket[]
  restocks        Restock[]
  subscriptions   Subscription[]
}

model Ticket {
  id        Int      @id @default(autoincrement())
  channelId        String   @unique
  controlMessageId String?
  userId           String
  gameId           Int
  game      Game     @relation(fields: [gameId], references: [id])
  status             String   @default("OPEN") // OPEN, CLAIMED, CLOSED
  staffId            String?
  screenshotVerified Boolean  @default(false)
  vouchExpiresAt        DateTime?
  vouchStaffId          String?
  vouchChannelMessageId String?
  deliveryMessageId     String?
  activeClosingStaffId  String?
  claimedAt             DateTime?
  closedAt              DateTime?
  lastUserActivityAt    DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt
  verification          PendingVerification?
}

model PendingVerification {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @unique
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  retryCount  Int      @default(0)
  isProcessing Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt
}

model Maintenance {
  id        Int      @id @default(autoincrement())
  channelId String   @unique
  messageId String
  endTime   DateTime
  createdAt DateTime @default(now())
}

model Cooldown {
  id        Int      @id @default(autoincrement())
  userId    String    @unique
  until     DateTime
  createdAt DateTime @default(now())
}

model Panel {
  id        Int      @id @default(autoincrement())
  channelId String
  messageId String
  createdAt DateTime @default(now())
}

// Bug #20: Verification model removed — unused (state is managed in-memory via pendingVerifications map)

model Restock {
  id        Int      @id @default(autoincrement())
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id])
  restockAt DateTime
  createdAt DateTime @default(now())
}

model Metadata {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    String
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

model DutyStatus {
  id          Int      @id @default(autoincrement())
  staffId     String   @unique
  isOnDuty    Boolean  @default(false)
  lastUpdated DateTime @default(now())
}

// Self-hosted, time-limited token download. Bot writes the file to a
// known directory + creates one row per delivery. Installer fetches the
// zip via GET /download/<token>. Expired or deleted rows return 404.
//
// Anti-sharing: each row also carries an `installerKey` separate from
// the download token. The installer.exe POSTs this key to
// /installer-validate/<key> on first run; the bot flips `consumed=true`
// and refuses subsequent calls. If a user shares the zip, the second
// installer run gets 410 → nuclear self-destruct.
// Cached Steam account session per steampass UUID. Lets the token
// generator skip steampass.gg for repeat gens of the same account:
//
//   1. Try refresh_token login (0 steampass calls — Steam CM accepts
//      the saved token directly, ~30-day TTL).
//   2. Fall back to cached login+password from a prior steampass fetch
//      (1 steampass call — only /email/code/main for the guard code,
//      we skip /profile/product-credentials).
//   3. Fall back to full steampass flow (2 calls — /profile + /email/code).
//
// Anything that succeeds writes the resulting refresh_token + creds back
// here so the next gen has a fresher cache to work with.
//
// Credentials are stored in plaintext for now — same trust boundary as
// steampass itself (which serves them in plaintext on every call). If
// we add at-rest encryption later it'd go here, with a key wrapped by
// the HMAC_SECRET env var.
model SteamSession {
  id              Int       @id @default(autoincrement())
  // Which tenant server this cached session belongs to. The steampass
  // UUID is GLOBAL (the same product UUID works on every steampass
  // account), but each buyer server logs in with its OWN steampass
  // account — so the resulting Steam session (login/password/refresh
  // token) is account-specific and must NOT leak across servers. Keying
  // by (guildId, steampassUuid) keeps Server A's cached session from
  // being reused for Server B even though they share the UUID.
  //
  // "" (empty string) = the owner/home server, which uses the global
  // STEAMPASS_LOGIN/PASSWORD env account. Defaulting to "" keeps every
  // pre-multitenant row valid (they were all the home account).
  guildId         String    @default("")
  steampassUuid   String
  // Cached Steam credentials from a prior /profile/product-credentials fetch.
  steamLogin      String
  steamPassword   String
  guarded         Boolean   @default(true)
  // Long-lived Steam refresh token (~30 day TTL). Null if we've never
  // managed to do a Steam CM login successfully, or if the last login
  // attempt didn't return a refresh token (older protocol path).
  refreshToken    String?
  steamId         String?
  // Health + telemetry — useful for staff log lines and the periodic
  // cleanup sweep that drops sessions inactive for >25 days (proactive
  // re-auth before the ~30-day refresh-token TTL bites us mid-gen).
  lastLoginAt     DateTime?
  lastLoginSource String?   // "refresh_token" | "cached_creds" | "steampass"
  failureCount    Int       @default(0)
  lastFailureAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([guildId, steampassUuid])
}

// A buyer server that has been sold/authorized to use the bot. The
// owner (OWNER_ROLE_ID in OWNER_GUILD_ID) provisions these via
// /addserver. Every field except the steampass account is optional and
// falls back to the global env CONFIG.* when null — so a server can be
// activated with just credentials and configured further later.
//
// SECURITY: steampassLogin/Password are the buyer server's steampass.gg
// account. They are visible ONLY to the owner (via /listservers in the
// home server) and are never logged to a tenant's own log channel.
// Stored in plaintext for now — same trust boundary as SteamSession
// (which already holds Steam creds in plaintext).
model TenantServer {
  id                  Int      @id @default(autoincrement())
  guildId             String   @unique
  serverName          String
  inviteLink          String?
  // Per-server steampass account (email + password). Swapped in for the
  // global STEAMPASS_LOGIN/PASSWORD env when this server generates a token.
  steampassLogin      String
  steampassPassword   String
  // Per-server Discord wiring. Null → fall back to global CONFIG.* env.
  logChannelId        String?  // BASIC log channel (sanitized events only)
  staffRoleId         String?
  activatorsRoleId    String?
  ticketCategoryId    String?
  voucherChannelId    String?
  stockNotifChannelId String?
  donatorRoleId       String?
  bronzeRoleId        String?
  silverRoleId        String?
  goldRoleId          String?
  botName             String?
  patreonUrl          String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

// ─── OWNER-ONLY steampass account pool ───────────────────────────
// The owner/home server can hold MULTIPLE steampass accounts and rotate
// between them. Each account can produce a limited number of tokens PER
// GAME PER 24h (Denuvo activation limit — default 5). When an account's
// daily quota for a given game is exhausted, the bot rotates to the next
// active account for that game until the UTC day rolls over.
//
// Buyer (tenant) servers do NOT use this pool — they each have a single
// steampass account on their TenantServer row and no rotation.
model SteampassAccount {
  id        Int      @id @default(autoincrement())
  label     String?               // human label, e.g. "acct-1"
  login     String   @unique      // steampass email
  password  String                // steampass password
  active    Boolean  @default(true)
  priority  Int      @default(100) // lower = tried first
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  usages    SteampassUsage[]
}

// Per-account, per-game, per-day token counter for the owner pool.
// usageDate is a "YYYY-MM-DD" UTC string so a daily reset is just a new
// key. count is capped in code at OWNER_TOKENS_PER_ACCOUNT_PER_DAY.
model SteampassUsage {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   SteampassAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appId     Int
  usageDate String   // "YYYY-MM-DD" UTC
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, appId, usageDate])
}

model TokenDownload {
  token         String   @id            // random opaque ID used in the download URL
  installerKey  String?  @unique        // separate per-zip secret embedded in payload-manifest.json
  // HMAC-binding: ties the installer key to THIS specific zip's ticket so
  // an attacker can't swap _sig in someone else's zip with an unused key
  // from their own. expectedHmac = hmac_sha256(HMAC_SECRET, sig|appId|ticketHash).
  // Server recomputes on validate and rejects on mismatch.
  ticketHash    String?                  // sha256(token_b64) — bound to this zip's actual ticket
  expectedHmac  String?                  // hmac_sha256(HMAC_SECRET, sig|appId|ticketHash)
  appId         Int?                     // bound app id for validation cross-check
  filePath      String                  // server-side absolute path
  fileName      String                  // suggested filename for Content-Disposition
  fileSize      Int                     // bytes (informational + Content-Length)
  expiresAt     DateTime                // hard cap — 30 min from createdAt
  createdAt     DateTime @default(now())
  claimedAt     DateTime?               // first time the file was streamed (for stats only)
  consumed      Boolean  @default(false) // true once /installer-validate has succeeded once
  consumedAt    DateTime?               // when the installer actually ran for this zip
  ticketId      Int?                    // optional link back to the ticket that produced this
  // True for tokens generated by /tokengen OUTSIDE a ticket channel
  // (staff testing, sharing, ad-hoc gen in a normal channel). When set:
  //   - the download link's expiresAt is set ~100 years in the future
  //     so /download and cleanupExpiredDownloads treat it as alive forever
  //   - /installer-validate doesn't flip `consumed` on success, so the
  //     installer can be re-run as many times as needed
  // Inside a ticket the field stays false and single-use enforcement
  // works as normal.
  persistent    Boolean  @default(false)
}
